@model HealthSync.Shared.Models.ChatMessage
@{
    ViewData["Title"] = "Edit Message";
}

<h2 class="mb-4"><i class="bi bi-pencil-square"></i> Edit Chat Message</h2>

<form asp-action="Edit" method="post" class="border p-4 bg-light rounded shadow-sm">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Content" class="form-label"></label>
        <textarea asp-for="Content" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Content" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        <i class="bi bi-save"></i> Save Changes
    </button>
    <a asp-action="Conversation" asp-route-patientUserId="@Model.ReceiverId" class="btn btn-secondary ms-2">Back</a>
</form>