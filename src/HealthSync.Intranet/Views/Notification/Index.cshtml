@using HealthSync.Shared.Models
@model List<Notification>

@{
    ViewData["Title"] = "My Notifications";
}

<h2 class="mb-4"><i class="bi bi-bell-fill me-1"></i> My Notifications</h2>

<a asp-action="Create" class="btn btn-success mb-3">
    <i class="bi bi-plus-circle-fill"></i> Create Notification
</a>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No notifications available.</div>
}
else
{
    <table class="table table-bordered table-hover shadow-sm">
        <thead class="table-dark text-center">
            <tr>
                <th>Message</th>
                <th>Date</th>
                <th>Status</th>
                <th style="width:180px;">Actions</th>
            </tr>
        </thead>
        <tbody class="text-center">
        @foreach (var n in Model)
        {
            var isRead = n.ReadStatuses.Any();
            <tr>
                <td class="text-start">@n.Message</td>
                <td>@n.CreatedAt.ToLocalTime():g</td>
                <td>
                    <span class="badge @(isRead ? "bg-secondary" : "bg-primary")">
                        @(isRead ? "Read" : "Unread")
                    </span>
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@n.Id"
                       class="btn btn-sm btn-outline-info me-1">
                        <i class="bi bi-eye-fill"></i>
                    </a>
                    <a asp-action="Edit" asp-route-id="@n.Id"
                       class="btn btn-sm btn-outline-warning me-1">
                        <i class="bi bi-pencil-square"></i>
                    </a>
                    <form asp-action="Delete" asp-route-id="@n.Id"
                          method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-outline-danger"
                                onclick="return confirm('Delete this notification?');">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
