@model HealthSync.Shared.Models.MedicalRecord

@{
    ViewData["Title"] = "Edit Medical Record";
    var appointments = ViewData["Appointments"] as List<HealthSync.Shared.Models.Appointment> ?? new();
}

<h2 class="mb-3">@ViewData["Title"]</h2>

<form asp-action="Edit" asp-controller="MedicalRecords" method="post">
    @Html.AntiForgeryToken()          <!-- CSRF -->
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="AppointmentId" class="form-label">Appointment</label>
        <select asp-for="AppointmentId" class="form-select" required>
            <option value="">-- Select Appointment --</option>
            @foreach (var appt in appointments)
            {
                <option value="@appt.Id" selected="@(appt.Id == Model.AppointmentId)">
                    @appt.PatientProfile.FirstName @appt.PatientProfile.LastName – @appt.AppointmentDate:g
                </option>
            }
        </select>
        <span asp-validation-for="AppointmentId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2 mt-2">
        <!-- ZAPIS -->
        <button type="submit" class="btn btn-warning">
            <i class="bi bi-save2"></i> Save changes
        </button>

        <!-- USUWANIE -->
        <button type="submit"
                formmethod="post"
                formaction="@Url.Action("Delete", "MedicalRecords", new { id = Model.Id })"
                class="btn btn-danger"
                onclick="return confirm('Are you sure you want to delete this record?');">
            <i class="bi bi-trash"></i> Delete
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}