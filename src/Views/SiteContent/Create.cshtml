@model HealthSync.Shared.Models.SiteContent
@{
    ViewData["Title"] = "Add New Content Block";
}

<h2 class="mb-4"><i class="bi bi-plus-circle"></i> Add Site Content</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Key" class="form-label">Content Identifier (Key)</label>
        <input asp-for="Key" class="form-control" placeholder="e.g. about, privacy, contact" required />
        <span asp-validation-for="Key" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Value" class="form-label">Content</label>
        <textarea asp-for="Value" class="form-control" rows="8" placeholder="Enter content here..." required></textarea>
        <span asp-validation-for="Value" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">
        <i class="bi bi-save"></i> Save Content
    </button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}