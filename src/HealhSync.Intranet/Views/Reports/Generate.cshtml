@{
    ViewData["Title"] = "Generate Report";
    var templates = ViewData["ReportTemplates"] as Dictionary<string, string> ?? new();
}

<h2 class="mb-4">
    <i class="bi bi-file-earmark-plus"></i> Generate New Report
</h2>

<form asp-action="Generate" method="post" class="row gy-3">

    <div class="col-md-6">
        <label class="form-label">Report Type</label>
        <select name="title" class="form-select" required>
            <option value="" selected disabled>— select —</option>
            @foreach (var kv in templates)
            {
                <option value="@kv.Key">@kv.Key &nbsp;–&nbsp; @kv.Value</option>
            }
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label">From</label>
        <input type="date" name="fromDate" class="form-control" />
    </div>

    <div class="col-md-3">
        <label class="form-label">To</label>
        <input type="date" name="toDate" class="form-control" />
    </div>

    <div class="col-12 mt-3">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-gear-wide-connected"></i> Generate
        </button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </div>
</form>