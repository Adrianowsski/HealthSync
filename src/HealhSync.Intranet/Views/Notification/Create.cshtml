@model HealthSync.Shared.Models.Notification
@{
    ViewData["Title"] = "Create Notification";
}

<h2 class="mb-4"><i class="bi bi-plus-circle-fill me-1"></i> Create Notification</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Message" class="form-label">Message</label>
        <textarea asp-for="Message" class="form-control" rows="4" required placeholder="Enter message..."></textarea>
        <span asp-validation-for="Message" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">
        <i class="bi bi-send-check"></i> Create
    </button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}