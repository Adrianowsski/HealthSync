@model List<HealthSync.Shared.Models.ChatMessage>
@{
    ViewData["Title"] = "Chat";
    var doctorName = ViewData["DoctorName"] as string;
    var appointmentId = ViewData["AppointmentId"];
    var receiverId = ViewData["ReceiverId"];
    var currentUser = User.Identity?.Name;
}

@section Styles {
    <style>
        .chat-container {
            background: #fff;
            border-radius: 0.75rem;
            padding: 1.5rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            max-height: 70vh;
            overflow-y: auto;
            margin-bottom: 1.5rem;
        }

        .bubble {
            padding: 0.75rem 1rem;
            border-radius: 1rem;
            max-width: 70%;
            position: relative;
        }

        .from-you {
            background-color: #007bff;
            color: white;
        }

        .from-doctor {
            background-color: #f1f1f1;
            color: black;
        }

        .chat-meta {
            font-size: 0.75rem;
            color: inherit;
        }

        .chat-action-icons {
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
        }

        .chat-action-icons i {
            cursor: pointer;
        }

        .chat-action-icons form {
            margin: 0;
        }
    </style>
}

<div class="container-fluid px-4">
    <h2 class="mb-4"><i class="bi bi-chat-dots"></i> Chat with Dr. @doctorName</h2>

    <div class="chat-container">
        @foreach (var msg in Model)
        {
            var isMe = msg.SenderId == currentUser;
            <div class="d-flex mb-3 @(isMe ? "justify-content-end" : "justify-content-start") align-items-start">
                @if (isMe)
                {
                    <div class="chat-action-icons me-2 text-nowrap">
                        <a asp-action="Edit" asp-route-id="@msg.Id" class="text-primary me-1" title="Edit">
                            <i class="bi bi-pencil-square fs-5"></i>
                        </a>
                        <form asp-action="Delete" asp-route-id="@msg.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-link text-danger p-0" title="Delete" onclick="return confirm('Delete this message?')">
                                <i class="bi bi-trash fs-5"></i>
                            </button>
                        </form>
                    </div>
                }

                <div class="bubble @(isMe ? "from-you" : "from-doctor")">
                    <div class="chat-meta mb-1 fw-bold">@((isMe ? "You" : "Dr."))</div>
                    @msg.Content
                    <div class="chat-meta text-end mt-1">@msg.SentAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                </div>
            </div>
        }

    </div>

    <form asp-action="Send" method="post" class="d-flex gap-2 align-items-start">
        <input type="hidden" name="appointmentId" value="@appointmentId" />
        <input type="hidden" name="receiverId" value="@receiverId" />
        <textarea name="content" class="form-control" rows="2" placeholder="Type your message..." required></textarea>
        <button type="submit" class="btn btn-primary"><i class="bi bi-send-fill"></i></button>
    </form>
</div>
