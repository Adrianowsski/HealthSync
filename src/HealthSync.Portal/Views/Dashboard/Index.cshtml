@using HealthSync.Shared.Models
@model List<HealthSync.Shared.Models.Appointment>

@{
    ViewData["Title"]  = "Patient Dashboard";

    var patient        = ViewBag.Patient        as PatientProfile;
    var prescriptions  = ViewBag.Prescriptions  as List<Prescription>;
    var records        = ViewBag.Records        as List<MedicalRecord>;
    var chatCount      = (int)(ViewBag.ChatCount ?? 0);
    var notifications  = ViewBag.Notifications  as List<Notification>;
    var whatsNewBlocks = ViewBag.WhatsNewList   as List<SiteContent> ?? new();
}

<div class="container-fluid px-4 py-4">
    <!-- Header ------------------------------------------------------->
    <div class="mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-person-heart text-primary me-2"></i>
            Welcome, @patient?.FirstName!
        </h2>
        <p class="text-muted">Here’s your current health summary.</p>
    </div>

    <!-- Stats -------------------------------------------------------->
    <div class="row g-3 mb-4">
        @* Appointments *@
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-muted">Appointments</div>
                        <div class="fs-4 fw-semibold text-primary">@Model.Count</div>
                    </div>
                    <i class="bi bi-calendar-check fs-3 text-primary"></i>
                </div>
            </div>
        </div>

        @* Prescriptions *@
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-muted">Prescriptions</div>
                        <div class="fs-4 fw-semibold text-success">@prescriptions?.Count</div>
                    </div>
                    <i class="bi bi-capsule fs-3 text-success"></i>
                </div>
            </div>
        </div>

        @* Records *@
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-muted">Medical Records</div>
                        <div class="fs-4 fw-semibold text-warning">@records?.Count</div>
                    </div>
                    <i class="bi bi-file-earmark-medical fs-3 text-warning"></i>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-muted">Messages</div>
                        <div class="fs-4 fw-semibold text-danger">@chatCount</div>
                    </div>
                    <i class="bi bi-chat-dots fs-3 text-danger"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Upcoming appointments --------------------------------------->
    <div class="card mb-4">
        <div class="card-header bg-white border-bottom fw-bold">
            <i class="bi bi-calendar-event me-2"></i> Your Upcoming Appointments
        </div>
        <div class="table-responsive">
            <table class="table table-hover table-bordered mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Doctor</th>
                        <th>Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>@a.DoctorProfile.FirstName @a.DoctorProfile.LastName</td>
                            <td>@a.AppointmentDate:f</td>
                            <td>
                                <span class="badge bg-@GetBadgeColor(a.Status)">
                                    @a.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Notifications ----------------------------------------------->
    @if (notifications?.Any() == true)
    {
        <div class="mb-4">
            <h5><i class="bi bi-bell-fill text-warning me-2"></i> Your Notifications</h5>

            @foreach (var n in notifications)
            {
                var isRead = n.ReadStatuses.Any();   // ← nowy sposób

                <div class="alert alert-secondary d-flex justify-content-between align-items-center shadow-sm rounded-3">
                    <div>
                        @n.Message<br/>
                        <small>@n.CreatedAt.ToLocalTime():g</small>
                    </div>
                    <div>
                        @if (isRead)
                        {
                            <span class="badge bg-secondary">Read</span>
                        }
                        else
                        {
                            <form asp-action="MarkAsRead" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@n.Id"/>
                                <button class="btn btn-sm btn-outline-warning">
                                    <i class="bi bi-check-circle"></i> Mark as Read
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <!-- What's New --------------------------------------------------->
    @if (whatsNewBlocks.Any())
    {
        <div class="mb-4">
            <h5><i class="bi bi-stars text-primary me-2"></i> What's New</h5>

            @foreach (var block in whatsNewBlocks)
            {
                <div class="bg-white shadow-sm p-3 rounded-3 mb-3">
                    @Html.Raw(block.Value)
                </div>
            }
        </div>
    }

    <!-- FAQ button --------------------------------------------------->
    <div class="text-end mt-4">
        <a asp-controller="Home" asp-action="FAQ" class="btn btn-outline-info">
            <i class="bi bi-question-circle"></i> FAQ
        </a>
    </div>
</div>

@functions{
    string GetBadgeColor(string status) => status switch
    {
        "Confirmed" => "success",
        "Scheduled" => "primary",
        "Pending"   => "warning text-dark",
        "Cancelled" => "danger",
        _           => "secondary"
    };
}
