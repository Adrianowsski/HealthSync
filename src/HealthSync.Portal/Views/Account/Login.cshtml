@model HealthSync.Portal.Models.LoginViewModel
@{
    ViewData["Title"] = "Patient Login";
}

<style>
    html, body {
        height: 100%;
    }

    body {
        display: flex;
        flex-direction: column;
    }

    main {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding-top: 5rem;
        padding-bottom: 2rem;
    }

    footer {
        background-color: #1a1a1a;
        color: #ccc;
        text-align: center;
        padding: 10px 0;
        font-size: 0.9rem;
    }
</style>

<main>
    <div class="col-md-5"> <!-- zwiększona szerokość z col-md-4 -->
        <div class="text-center mb-3">
            <i class="bi bi-heart-pulse-fill text-danger" style="font-size: 3rem;"></i>
            <h3 class="mt-2 text-dark fw-bold">HealthSync</h3>
        </div>
        <div class="card shadow">
            <div class="card-header bg-dark text-white text-center">
                <h4><i class="bi bi-person-circle"></i> Patient Login</h4>
            </div>
            <div class="card-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                <form asp-action="Login" method="post" novalidate>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-box-arrow-in-right"></i> Log In
                    </button>
                </form>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
