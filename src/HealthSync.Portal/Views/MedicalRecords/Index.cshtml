@model IEnumerable<HealthSync.Shared.Models.MedicalRecord>
@{
    ViewData["Title"] = "Medical Records";
    var search = ViewData["Search"]?.ToString() ?? "";
    var items  = Model ?? Enumerable.Empty<HealthSync.Shared.Models.MedicalRecord>();
}

<h2 class="mb-4"><i class="bi bi-file-earmark-medical"></i> Medical Records</h2>

@if (TempData["ErrorMessage"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<form method="get" class="row g-2 mb-4">
    <div class="col-md-10">
        <input type="text" name="search" value="@search" class="form-control"
               placeholder="Search by description…">
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary w-100">
            <i class="bi bi-search"></i> Search
        </button>
    </div>
</form>

@if (!items.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> No records found.
    </div>
}
else
{
    <form asp-controller="MedicalRecords"
          asp-action="BulkDownload"
          method="post">
        @Html.AntiForgeryToken()

        <div class="table-responsive shadow-sm rounded">
            <table class="table table-bordered table-hover align-middle text-center"
                   id="recordsTable">
                <thead class="table-dark">
                    <tr>
                        <th style="width:44px;">
                            <input type="checkbox" id="selectAll" />
                        </th>
                        <th>Date</th>
                        <th>Description</th>
                        <th style="width:120px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in items)
                {
                    <tr>
                        <td>
                            <input type="checkbox"
                                   class="rowCheck"
                                   name="ids"
                                   value="@r.Id" />
                        </td>
                        <td>@(r.Appointment?.AppointmentDate.ToString("f") ?? "-")</td>
                        <td>@(r.Description ?? "-")</td>
                        <td>
                            <a asp-action="Download"
                               asp-route-id="@r.Id"
                               class="btn btn-sm btn-outline-success"
                               title="Single PDF">
                                <i class="bi bi-file-earmark-arrow-down"></i>
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <button type="submit"
                class="btn btn-success mt-3"
                id="bulkBtn"
                disabled>
            <i class="bi bi-file-earmark-zip"></i> Download selected as ZIP
        </button>
    </form>
}

@section Scripts {
    <script>
        const selectAll = document.getElementById("selectAll");
        const bulkBtn   = document.getElementById("bulkBtn");

        function toggleBtn() {
            const any = Array.from(document.querySelectorAll(".rowCheck"))
                              .some(cb => cb.checked);
            bulkBtn.disabled = !any;
        }

        if (selectAll) {
            selectAll.addEventListener("change", e =>
                document.querySelectorAll(".rowCheck")
                        .forEach(cb => cb.checked = e.target.checked));
        }

        document.querySelectorAll(".rowCheck").forEach(cb =>
            cb.addEventListener("change", toggleBtn));
    </script>
}
