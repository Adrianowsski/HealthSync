@model IEnumerable<HealthSync.Shared.Models.SiteContent>
@using HealthSync.Shared.Models

@{
    ViewData["Title"] = "Welcome to HealthSync";
    Layout = "_Layout";
}

<!-- ★ Twoje dotychczasowe, statyczne powitanie ★ -->
<div class="container d-flex flex-column align-items-center justify-content-center" style="min-height: 60vh;">
    <div class="text-center" style="max-width: 600px; margin: 0 auto;">
        <p class="text-uppercase text-muted small mb-2">Your health companion</p>

        <h1 class="display-4 mb-3">
            <i class="bi bi-heart-pulse-fill text-danger"></i> Welcome to HealthSync
        </h1>

        <p class="mb-4 text-secondary" style="font-size: 1.1rem;">
            Manage appointments, prescriptions, and medical records – all in one place.
        </p>

        <div class="d-flex justify-content-center gap-3">
            <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Login">
                <i class="bi bi-box-arrow-in-right me-1"></i> Log In
            </a>
            <a class="btn btn-outline-primary btn-lg" asp-controller="Account" asp-action="Register">
                <i class="bi bi-person-plus me-1"></i> Register
            </a>
        </div>
    </div>
</div>