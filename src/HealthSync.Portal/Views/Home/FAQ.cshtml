@model IEnumerable<HealthSync.Shared.Models.SiteContent>

@{
    ViewData["Title"] = "FAQ";
    Layout = "_Layout";
}

@section Styles {
    <style>
        .preserve-whitespace {
            white-space: pre-wrap;
        }
    </style>
}

<div class="container py-4">
    <h2 class="mb-4"><i class="bi bi-question-circle-fill text-info"></i> FAQ</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No FAQ content available.</div>
    }
    else
    {
        <div class="accordion" id="faqAccordion">
            @foreach (var (block, i) in Model.Select((block, index) => (block, index)))
            {
                var parts = block.Value.Split(new[] { "\r\n", "\n" }, 2, StringSplitOptions.None);
                var question = parts[0].Trim();
                var answer = parts.Length > 1 ? parts[1].Trim() : "";

                string collapseId = $"collapse{i}";
                string headingId = $"heading{i}";

                <div class="accordion-item">
                    <h2 class="accordion-header" id="@headingId">
                        <button class="accordion-button collapsed"
                                type="button"
                                data-collapse-id="@collapseId"
                                aria-expanded="false"
                                aria-controls="@collapseId">
                            @question
                        </button>
                    </h2>
                    <div id="@collapseId"
                         class="accordion-collapse collapse"
                         aria-labelledby="@headingId">
                        <div class="accordion-body preserve-whitespace">
                            @answer
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const buttons = document.querySelectorAll('#faqAccordion .accordion-button');

        buttons.forEach(btn => {
            btn.addEventListener('click', function (e) {
                const targetId = this.getAttribute('data-collapse-id');
                const targetEl = document.getElementById(targetId);
                const isOpen = targetEl.classList.contains('show');

                // Zamknij wszystkie
                document.querySelectorAll('#faqAccordion .accordion-collapse').forEach(el => {
                    const instance = bootstrap.Collapse.getInstance(el) || new bootstrap.Collapse(el, { toggle: false });
                    instance.hide();
                });

                // Jeżeli nie był otwarty, otwórz go
                if (!isOpen) {
                    const instance = bootstrap.Collapse.getInstance(targetEl) || new bootstrap.Collapse(targetEl, { toggle: false });
                    instance.show();
                }
                // Jeśli był otwarty – zostaje zamknięty i nic nie otwieramy
            });
        });
    </script>
}
