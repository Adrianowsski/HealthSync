@model IEnumerable<HealthSync.Shared.Models.SiteContent>

@{
    ViewData["Title"] = "Privacy Policy";
    Layout = "_Layout";
}

@section Styles {
    <style>
        .preserve-whitespace {
            white-space: pre-wrap;
        }
        .privacy-title {
            font-weight: 600;
            font-size: 1.1rem;
            margin-bottom: 0.5rem;
        }
    </style>
}

<div class="container py-4">
    <h2 class="mb-4"><i class="bi bi-shield-lock-fill text-dark"></i> Privacy Policy</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No privacy content available.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var block in Model)
            {
                var parts = block.Value.Split(new[] { "\r\n", "\n" }, 2, StringSplitOptions.None);
                var title = parts[0].Trim();
                var body = parts.Length > 1 ? parts[1].Trim() : "";

                <div class="col-12">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <div class="privacy-title">@title</div>
                            <div class="text-secondary preserve-whitespace">@body</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>