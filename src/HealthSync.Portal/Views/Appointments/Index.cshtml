@model List<HealthSync.Shared.Models.Appointment>

@{
    ViewData["Title"] = "Your Appointments";
}

<h2><i class="bi bi-calendar-check me-2"></i> Appointments</h2>

<div class="table-responsive">
    <table class="table table-bordered table-hover">
        <thead class="table-dark text-center">
        <tr>
            <th>Doctor</th>
            <th>Date</th>
            <th>Status</th>
        </tr>
        </thead>
        <tbody class="text-center">
        @foreach (var appt in Model)
        {
            <tr>
                <td>@appt.DoctorProfile.FirstName @appt.DoctorProfile.LastName</td>
                <td>@appt.AppointmentDate.ToString("f")</td>
                <td><span class="badge @GetBadgeClass(appt.Status)">@appt.Status</span></td>
            </tr>
        }
        </tbody>
    </table>
</div>

@functions {
    string GetBadgeClass(string status) => status switch
    {
        "Scheduled" => "bg-primary",
        "Confirmed" => "bg-success",
        "Cancelled" => "bg-danger",
        _ => "bg-secondary"
    };
}
