@model List<HealthSync.Shared.Models.SiteContent>
@{
    ViewData["Title"] = "Manage Site Content";
}

<h2 class="mb-4"><i class="bi bi-file-earmark-text"></i> Site Content</h2>

<a asp-action="Create" class="btn btn-success mb-3">
    <i class="bi bi-plus-circle"></i> Add New Content
</a>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<table class="table table-bordered table-hover shadow-sm">
    <thead class="table-dark">
    <tr>
        <th>Key</th>
        <th>Content Preview</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Key</td>
            <td>@item.Value.Substring(0, Math.Min(item.Value.Length, 50))...</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this content?')">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
