@model HealthSync.Shared.Models.Appointment
@{
    ViewData["Title"] = "Edit Appointment";
    var patients = ViewData["Patients"] as List<HealthSync.Shared.Models.PatientProfile> ?? new();
    var timeSlots = Enumerable.Range(0, 18)
        .Select(i => TimeSpan.FromMinutes(9 * 60 + i * 30))
        .Select(t => $"{t:hh\\:mm} - {t.Add(TimeSpan.FromMinutes(30)):hh\\:mm}")
        .ToList();

    var selectedTime = Model.AppointmentDate.ToString("HH:mm");
    var selectedDate = Model.AppointmentDate.ToString("yyyy-MM-dd");
}

<h2 class="mb-4"><i class="bi bi-pencil-square me-1"></i> Edit Appointment</h2>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <form id="editForm" asp-action="Edit" method="post" class="border p-4 shadow-sm rounded bg-light">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" name="AppointmentDate" id="AppointmentDate" />

            <div class="mb-3">
                <label class="form-label">Patient</label>
                <select asp-for="PatientProfileId" class="form-select" required>
                    <option value="">-- Select Patient --</option>
                    @foreach (var p in patients)
                    {
                        <option value="@p.Id" selected="@(p.Id == Model.PatientProfileId)">
                            @p.FirstName @p.LastName
                        </option>
                    }
                </select>
                <span asp-validation-for="PatientProfileId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Select Date</label>
                <input type="date" id="datePicker" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@selectedDate" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Select Time Slot</label>
                <select id="timeSlot" class="form-select" required>
                    <option value="">-- Select Time Slot --</option>
                    @foreach (var slot in timeSlots)
                    {
                        var time = slot.Split(" - ")[0];
                        <option value="@slot" selected="@(selectedTime == time ? "selected" : null)">
                            @slot
                        </option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Status</label>
                <select asp-for="Status" class="form-select" required>
                    <option value="Scheduled" selected="@(Model.Status == "Scheduled")">Scheduled</option>
                    <option value="Confirmed" selected="@(Model.Status == "Confirmed")">Confirmed</option>
                    <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Cancelled</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2 mt-3">
                <button type="button" class="btn btn-success" onclick="confirmSave()">
                    <i class="bi bi-save2 me-1"></i> Save Changes
                </button>

                <button type="button" class="btn btn-danger" onclick="confirmDelete()">
                    <i class="bi bi-trash me-1"></i> Delete
                </button>
            </div>
        </form>

        <form id="deleteForm" method="post" asp-action="Delete" asp-route-id="@Model.Id"></form>
    </div>
</div>

<!-- SAVE MODAL -->
<div class="modal fade" id="saveModal" tabindex="-1" aria-labelledby="saveModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Save</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">Are you sure you want to save changes to this appointment?</div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                <button class="btn btn-success" onclick="submitSave()">Yes, Save</button>
            </div>
        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">Are you sure you want to delete this appointment?</div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                <button class="btn btn-danger" onclick="submitDelete()">Yes, Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function confirmSave() {
            const date = document.getElementById('datePicker').value;
            const time = document.getElementById('timeSlot').value.split(" - ")[0];
            if (!date || !time) {
                alert("Please select both date and time.");
                return;
            }
            document.getElementById('AppointmentDate').value = `${date}T${time}:00`;

            const modal = new bootstrap.Modal(document.getElementById('saveModal'));
            modal.show();
        }

        function submitSave() {
            document.getElementById('editForm').submit();
        }

        function confirmDelete() {
            const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }

        function submitDelete() {
            document.getElementById('deleteForm').submit();
        }
    </script>
}
