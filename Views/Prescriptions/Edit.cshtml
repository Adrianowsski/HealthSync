@model HealthSync.Shared.Models.Prescription

@{
    ViewData["Title"] = "Edit Prescription";
    var appointments = ViewData["Appointments"] as List<HealthSync.Shared.Models.Appointment> ?? new();
}

<h2 class="mb-4"><i class="bi bi-pencil"></i> Edit Prescription</h2>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <form asp-action="Edit" method="post" class="border p-4 rounded shadow-sm bg-light">
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="AppointmentId" class="form-label">Appointment</label>
                <select asp-for="AppointmentId" class="form-select">
                    <option value="">-- Select Appointment --</option>
                    @foreach (var a in appointments)
                    {
                        <option value="@a.Id" selected="@(a.Id == Model.AppointmentId)">
                            @a.PatientProfile.FirstName @a.PatientProfile.LastName — @a.AppointmentDate.ToString("g")
                        </option>
                    }
                </select>
                <span asp-validation-for="AppointmentId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MedicationName" class="form-label"></label>
                <input asp-for="MedicationName" class="form-control" />
                <span asp-validation-for="MedicationName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Dosage" class="form-label"></label>
                <input asp-for="Dosage" class="form-control" />
                <span asp-validation-for="Dosage" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Duration" class="form-label"></label>
                <input asp-for="Duration" class="form-control" />
                <span asp-validation-for="Duration" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Instructions" class="form-label"></label>
                <textarea asp-for="Instructions" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Instructions" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> Update
                </button>

                <form asp-action="Delete" method="post" asp-route-id="@Model.Id">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                </form>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
